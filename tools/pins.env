# Pinned check toolchain. KEY=VALUE lines only, read by tools/fetch-tools.sh
# (parsed, never sourced). A pin changes only through a PR that runs the full
# check (ADR-0001 pinning procedure, ADR-0002).

# Hugo standard edition, linux-amd64 (ADR-0001). Pinned 2026-11-04; v0.169.0
# was the latest stable that day. SHA-256 checked against
# hugo_0.169.0_checksums.txt of the release AND GitHub's asset digest.
HUGO_VERSION=0.169.0
HUGO_URL=https://github.com/gohugoio/hugo/releases/download/v0.169.0/hugo_0.169.0_linux-amd64.tar.gz
HUGO_SHA256=2d2f0bfe357d8cb4cec02f6bb28a3bff34978c8dda44b618029c5eb9d66765a7

# lychee, x86_64 Linux gnu tarball (ADR-0002 part 2). Pinned 2026-11-04;
# v0.24.2 was the latest stable that day (nightly excluded). SHA-256 checked
# against the release's .sha256 sidecar AND GitHub's asset digest.
LYCHEE_VERSION=0.24.2
LYCHEE_URL=https://github.com/lycheeverse/lychee/releases/download/lychee-v0.24.2/lychee-x86_64-unknown-linux-gnu.tar.gz
LYCHEE_SHA256=1f4e0ef7f6554a6ed33dd7ac144fb2e1bbed98598e7af973042fc5cd43951c9a

# workerd, the open-source Workers runtime, linux-64 (ADR-0006 part 2). The
# intake Worker's tests run under it (tools/check.sh step worker), and the
# deploy tool uploads WORKERD_COMPAT_DATE as the Worker's compatibility_date,
# so the tests and production run the same runtime semantics (ADR-0006
# Numbers, "workerd pin"). Pinned 2026-11-12: v1.20261110.1, the release
# ADR-0006 Context cites, published 2026-11-10. WORKERD_SHA256 is the SHA-256
# of the .gz asset, checked against GitHub's asset digest of the release AND
# the downloaded file. A workerd upgrade changes all four keys in one PR.
WORKERD_VERSION=1.20261110.1
WORKERD_URL=https://github.com/cloudflare/workerd/releases/download/v1.20261110.1/workerd-linux-64.gz
WORKERD_SHA256=6d710b0f310e21383ee52fe8c71aa8cca3f51c2c04a48ec03e56868e97e1e65d
WORKERD_COMPAT_DATE=2026-11-10

# Lighthouse, CI only, in the job `lighthouse` of lighthouse.yml (ADR-0003
# part 1). Pinned 2026-11-04: 13.6.0 was published 2026-10-27, before the
# cooldown date. LIGHTHOUSE_BEFORE is the pin date minus 7 days: the resolver
# ignores every version published after it. LIGHTHOUSE_TREE_SHA256 is the
# digest `sitecheck tree-digest` prints for the tree resolved in CI; the job
# fails before any registry code runs when the resolved tree differs.
# Bootstrapped by run 41913851725: 132 packages, the name@version list is
# in that run's log and in PR #15.
LIGHTHOUSE_VERSION=13.6.0
LIGHTHOUSE_BEFORE=2026-10-28T00:00:00Z
LIGHTHOUSE_TREE_SHA256=0e9567d2c414ce5a690690bc7f213ffd045afe76e732ed7b5580bc530c43830d

# Nu Html Checker container image, CI only (ADR-0002 part 1). Pinned
# 2026-11-04: the index digest of ghcr.io/validator/validator:latest that day,
# read from the registry's Docker-Content-Digest header (image created
# 2026-11-04T06:17:51Z, upstream revision 26b30abaf6fa).
VNU_IMAGE=ghcr.io/validator/validator@sha256:0af71abb9e40083cc0e8b3fcbe51a55a45889c662a3f507fbf1f9f013a109842

# GitHub Actions allowlist (ADR-0002 part 6), read by the guard in
# tools/sitecheck.py: every `uses:` in .github/workflows/ must equal one of
# these actions/<name>@<sha> values exactly. The owner check alone is not
# enough: GitHub resolves a commit that exists only in a fork through the
# parent repo, so actions/<name>@<fork-sha> would run third-party code.
# Pinned 2026-11-04: each SHA is what the upstream tag ref resolves to
# (GET /repos/actions/<name>/git/ref/tags/<tag>, object type commit).
# Tag v7.0.1.
ACTION_CHECKOUT=actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
# Tag v5.0.0.
ACTION_UPLOAD_PAGES_ARTIFACT=actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9
# Tag v7.0.2.
ACTION_UPLOAD_ARTIFACT=actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
# Tag v8.0.2.
ACTION_DOWNLOAD_ARTIFACT=actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
