# The workerd configuration of the intake Worker's tests (ADR-0006 part 2,
# tests/worker/test_intake.py). workerd emulates the three bindings the
# Worker uses in production:
#   EMAIL         the send_email binding: the RPC service capture.js, which
#                 records every send() call instead of mailing
#   RATE_LIMITER  the Rate Limiting binding: the RPC service burst.js
#   LIMITER       the Durable Object IntakeLimiter, SQLite-backed, stored in
#                 a temporary directory the test passes as limiter-store
# Every socket is passed in by the test as an already bound loopback socket
# (--socket-fd), so no port is guessed. compatibilityDate equals
# WORKERD_COMPAT_DATE in tools/pins.env (test_config_matches_pins), which the
# deploy tool uploads as the Worker's compatibility_date.
#
# LIMITER_KEY here is a test value, public on purpose; the production secret
# is generated by tools/intake.py on the first deploy and never leaves
# Cloudflare.

using Workerd = import "/workerd/workerd.capnp";

const config :Workerd.Config = (
  services = [
    (name = "intake", worker = .intake),
    # The same Worker with a limiter that throws on every call: the Worker
    # must fail closed (#error, no mail).
    (name = "intake-broken-limiter", worker = .intakeBrokenLimiter),
    # The same Worker with a malformed LIMITER_KEY: an exception no inner
    # handler catches, which the top-level handler maps to #error.
    (name = "intake-bad-key", worker = .intakeBadKey),
    (name = "capture", worker = .capture),
    (name = "burst", worker = .burst),
    (name = "probe", worker = .probe),
    (name = "limiter-store", disk = (writable = true)),
  ],
  sockets = [
    (name = "intake", address = "127.0.0.1:0", http = (), service = "intake"),
    (name = "intake-broken-limiter", address = "127.0.0.1:0", http = (),
     service = "intake-broken-limiter"),
    (name = "intake-bad-key", address = "127.0.0.1:0", http = (),
     service = "intake-bad-key"),
    (name = "probe", address = "127.0.0.1:0", http = (), service = "probe"),
  ],
);

const intake :Workerd.Worker = (
  modules = [(name = "intake.js", esModule = embed "../../worker/intake.js")],
  compatibilityDate = "2026-11-10",
  bindings = [
    (name = "EMAIL", service = "capture"),
    (name = "RATE_LIMITER", service = "burst"),
    (name = "LIMITER", durableObjectNamespace = "IntakeLimiter"),
    (name = "LIMITER_KEY", text = "f17474ac183f5727b19cad79d6bcc87ce754d404e1b5ffaf7ff3f83346bf0246"),
  ],
  durableObjectNamespaces = [
    (className = "IntakeLimiter", uniqueKey = "interviewscam-intake-test", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "limiter-store"),
);

const intakeBrokenLimiter :Workerd.Worker = (
  modules = [(name = "intake.js", esModule = embed "../../worker/intake.js")],
  compatibilityDate = "2026-11-10",
  bindings = [
    (name = "EMAIL", service = "capture"),
    (name = "RATE_LIMITER", service = "burst"),
    (name = "LIMITER", durableObjectNamespace = (className = "BrokenLimiter", serviceName = "probe")),
    (name = "LIMITER_KEY", text = "f17474ac183f5727b19cad79d6bcc87ce754d404e1b5ffaf7ff3f83346bf0246"),
  ],
);

const intakeBadKey :Workerd.Worker = (
  modules = [(name = "intake.js", esModule = embed "../../worker/intake.js")],
  compatibilityDate = "2026-11-10",
  bindings = [
    (name = "EMAIL", service = "capture"),
    (name = "RATE_LIMITER", service = "burst"),
    (name = "LIMITER", durableObjectNamespace = (className = "IntakeLimiter", serviceName = "intake")),
    (name = "LIMITER_KEY", text = "not-a-key"),
  ],
);

const capture :Workerd.Worker = (
  modules = [(name = "capture.js", esModule = embed "capture.js")],
  compatibilityDate = "2026-11-10",
);

const burst :Workerd.Worker = (
  modules = [(name = "burst.js", esModule = embed "burst.js")],
  compatibilityDate = "2026-11-10",
);

const probe :Workerd.Worker = (
  modules = [
    (name = "probe.js", esModule = embed "probe.js"),
    (name = "intake.js", esModule = embed "../../worker/intake.js"),
  ],
  compatibilityDate = "2026-11-10",
  bindings = [
    (name = "LIMITER", durableObjectNamespace = (className = "IntakeLimiter", serviceName = "intake")),
    (name = "CAPTURE", service = "capture"),
    (name = "BURST", service = "burst"),
  ],
  durableObjectNamespaces = [
    (className = "BrokenLimiter", uniqueKey = "interviewscam-intake-test-broken"),
  ],
  durableObjectStorage = (inMemory = void),
);
